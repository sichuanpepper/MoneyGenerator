import yfinance as yf
import requests
import os
import json
import time
from dotenv import load_dotenv

# =========================
# 初始化
# =========================
load_dotenv()

WEBHOOK_URL = os.getenv("SLACK_WEBHOOK")

STATE_FILE = "state_system.json"
WATCHLIST_FILE = "watchlist.json"


# =========================
# 基础工具
# =========================
def send_slack(msg):
    if WEBHOOK_URL:
        requests.post(WEBHOOK_URL, json={"text": msg})


def load_state():
    if os.path.exists(STATE_FILE):
        return json.load(open(STATE_FILE))
    return {}


def save_state(state):
    json.dump(state, open(STATE_FILE, "w"), indent=2)


def load_symbols():
    if os.path.exists(WATCHLIST_FILE):
        return json.load(open(WATCHLIST_FILE)).get("symbols", [])
    return []


# =========================
# RSI
# =========================
def rsi(series, period=14):
    delta = series.diff()
    gain = delta.clip(lower=0)
    loss = -delta.clip(upper=0)
    avg_gain = gain.rolling(period).mean()
    avg_loss = loss.rolling(period).mean()
    rs = avg_gain / avg_loss
    return 100 - (100 / (1 + rs))


# =========================
# 市场状态（SPY）
# =========================
def get_market_regime():

    data = yf.download("SPY", period="1y", interval="1d")

    if data.empty or len(data) < 210:
        return "UNKNOWN"

    data["SMA50"] = data["Close"].rolling(50).mean()
    data["SMA200"] = data["Close"].rolling(200).mean()
    data = data.dropna()

    latest = data.iloc[-1]
    prev = data.iloc[-2]

    price = float(latest["Close"].iloc[0])
    sma50 = float(latest["SMA50"].iloc[0])
    sma200 = float(latest["SMA200"].iloc[0])
    prev_sma200 = float(prev["SMA200"].iloc[0])

    sma200_up = sma200 > prev_sma200

    if price > sma200 and sma50 > sma200 and sma200_up:
        return "BULL"
    elif price < sma200 and sma50 < sma200:
        return "BEAR"
    return "NEUTRAL"


# =========================
# Long-term
# =========================
def get_long_term(symbol):

    data = yf.download(symbol, period="1y", interval="1d")

    if data.empty or len(data) < 210:
        return "NEUTRAL"

    data["SMA50"] = data["Close"].rolling(50).mean()
    data["SMA200"] = data["Close"].rolling(200).mean()
    data = data.dropna()

    latest = data.iloc[-1]
    prev = data.iloc[-2]

    price = float(latest["Close"].iloc[0])
    sma200 = float(latest["SMA200"].iloc[0])
    prev_sma200 = float(prev["SMA200"].iloc[0])

    if price > sma200 and sma200 > prev_sma200:
        return "BULLISH"
    elif price < sma200:
        return "BEARISH"
    return "NEUTRAL"


# =========================
# Short-term
# =========================
def get_short_term(symbol):

    data = yf.download(symbol, period="5d", interval="5m")

    if data.empty:
        return "HOLD"

    data["MA20"] = data["Close"].rolling(20).mean()
    data["MA50"] = data["Close"].rolling(50).mean()
    data["RSI"] = rsi(data["Close"])
    data = data.dropna()

    latest = data.iloc[-1]

    price = float(latest["Close"].iloc[0])
    ma20 = float(latest["MA20"].iloc[0])
    ma50 = float(latest["MA50"].iloc[0])
    rsi_val = float(latest["RSI"].iloc[0])

    score = 0

    if ma20 > ma50:
        score += 1
    else:
        score -= 1

    if price > ma20:
        score += 1
    else:
        score -= 1

    if 40 <= rsi_val <= 60:
        score += 1
    elif rsi_val > 70:
        score -= 2
    elif rsi_val < 30:
        score += 1

    if score >= 2:
        return "BUY"
    elif score <= -2:
        return "SELL"
    return "HOLD"


# =========================
# 信号融合
# =========================
def fuse_signal(short, long, market):

    if market == "BEAR":
        if short == "BUY":
            return "BLOCKED BUY"
        if short == "SELL":
            return "STRONG SELL"
        return "HOLD"

    if market == "NEUTRAL":
        if short == "BUY" and long == "BULLISH":
            return "WEAK BUY"
        if short == "SELL":
            return "SELL"
        return "HOLD"

    if market == "BULL":
        if short == "BUY" and long == "BULLISH":
            return "STRONG BUY"
        if short == "SELL":
            return "WEAK SELL"
        return "HOLD"

    return "HOLD"


# =========================
# 仓位管理
# =========================
def get_position(signal, market):

    if market == "BULL":
        return {
            "STRONG BUY": 80,
            "WEAK BUY": 60,
            "HOLD": 40,
            "WEAK SELL": 20
        }.get(signal, 30)

    if market == "BEAR":
        return {
            "STRONG SELL": 0,
            "SELL": 10,
            "HOLD": 20,
            "BLOCKED BUY": 10
        }.get(signal, 10)

    return {
        "BUY": 40,
        "HOLD": 30,
        "SELL": 20
    }.get(signal, 30)


# =========================
# 主系统
# =========================
def run():

    state = load_state()
    send_slack("🚀 FINAL SYSTEM STARTED")

    while True:

        symbols = load_symbols()

        if not symbols:
            time.sleep(60)
            continue

        market = get_market_regime()

        for s in symbols:

            short = get_short_term(s)
            long = get_long_term(s)

            final = fuse_signal(short, long, market)
            position = get_position(final, market)

            prev = state.get(s, {})

            if prev.get("signal") != final or prev.get("position") != position:

                msg = f"""
🧠 FINAL DECISION - {s}

Market: {market}
Short: {short}
Long: {long}

👉 Signal: {final}
💰 Position: {position}%
"""

                send_slack(msg)

                state[s] = {
                    "signal": final,
                    "position": position
                }

        save_state(state)

        time.sleep(300)


if __name__ == "__main__":
    run()
